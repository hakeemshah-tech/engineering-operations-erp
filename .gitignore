# =============================================================================
# Master .gitignore - workspace root. Nothing below this line should ever
# reach the public repository.
# =============================================================================

# ----- Dependencies ----------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
jspm_packages/

# ----- Build outputs ---------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
.next/
.nuxt/
.output/
.vite/
*.tsbuildinfo

# ----- Task-runner / bundler caches ------------------------------------------
.turbo/
**/.turbo/
.cache/
.cache-loader/
.parcel-cache/
.eslintcache
.stylelintcache
.rollup.cache/

# ----- Environment & secrets -------------------------------------------------
# Never commit real credentials. `.env.example` is the only tracked variant.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets.json
serviceAccount*.json
credentials.json

# ----- AI assistants, IDEs & editors -----------------------------------------
.vscode/
.vscode-test/
.cursor/
.cursorrules
.cursorignore
.claude/
CLAUDE.md
.aider*
.windsurf/
.continue/
.github-copilot/
.idea/
*.iml
*.ipr
*.iws
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.settings/

# ----- OS cruft --------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- Logs & runtime --------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock

# ----- Test & coverage output ------------------------------------------------
coverage/
**/coverage/
.nyc_output/
jest-test-results.json
test-results/
playwright-report/

# ----- Local data & user uploads --------------------------------------------
# Runtime upload targets are tracked as empty directories via .gitkeep only;
# the files themselves may contain personal data and must stay out of git.
backend/uploads/**
!backend/uploads/
!backend/uploads/**/
!backend/uploads/**/.gitkeep
*.sqlite
*.sqlite3
*.db
*.db-journal
dump.rdb

# ----- Misc ------------------------------------------------------------------
*.tgz
*.zip
*.tar.gz
.temp/
tmp/
