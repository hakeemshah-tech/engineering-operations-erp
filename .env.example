# =============================================================================
# Environment template - copy, don't edit in place.
#
#   cp .env.example .env                 # docker compose reads this one
#   cp .env.example backend/.env         # keep the [BACKEND] block
#   cp .env.example frontend/.env        # keep the [FRONTEND] block
#
# Only this file is tracked by git. Every .env is ignored - never commit real
# credentials, and rotate anything that reaches a shared machine.
# =============================================================================


# -----------------------------------------------------------------------------
# [BACKEND] - Express API (backend/.env, loaded by dotenv)
# -----------------------------------------------------------------------------

# Port the Express server binds to.
PORT=5000

# development | production - production tightens error output.
NODE_ENV=development

# MongoDB connection string. The API exits on boot if this is unset.
#   local install  → mongodb://localhost:27017/enterprise_erp
#   docker compose → mongodb://mongo:27017/enterprise_erp   (service name)
#   Atlas          → mongodb+srv://<user>:<password>@<cluster>/enterprise_erp
MONGODB_URI=mongodb://localhost:27017/enterprise_erp

# Signing key for access tokens. The API exits on boot if this is unset;
# there is deliberately no default, because a shipped default is a public key.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Redis connection string. Reserved for the write-through cache described in
# docs/adr/002-implement-write-through-redis-cache.md; the API does not read
# it yet, and docker compose starts the container regardless.
REDIS_URL=redis://localhost:6379

# Credentials for `npm run seed --workspace backend`, which creates the first
# admin account. The seed script refuses to run without a password; there is
# no built-in default.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=


# -----------------------------------------------------------------------------
# [FRONTEND] - Vite SPA (frontend/.env)
#
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time. Changing one means restarting the dev server or rebuilding the image;
# these are not runtime configuration.
# -----------------------------------------------------------------------------

# Base URL of the Express API.
#   local dev        → http://localhost:5000
#   docker compose   → http://localhost:5000  (published port on the host)
#   deployed         → https://api.example.com
VITE_API_BASE_URL=http://localhost:5000

# Google Maps JavaScript API key. Optional.
# Enables the "Pick on map" tab in the Location create/edit forms (interactive
# map, marker placement, Places autocomplete, geofence radius preview). Without
# it the form still works via Manual entry and Device GPS - only the map tab is
# disabled.
#
# Enable these Google Cloud APIs for the key: Maps JavaScript API, Places API.
# Restrict it by HTTP referrer to your dev and production hosts; an
# unrestricted browser key is billable by anyone who finds it.
VITE_GOOGLE_MAPS_API_KEY=


# -----------------------------------------------------------------------------
# [COMPOSE] - read by docker-compose.yml from the ROOT .env only
# -----------------------------------------------------------------------------

# Host ports. Change these if something already occupies them locally.
CLIENT_PORT=5173
API_PORT=5000
MONGO_PORT=27017
REDIS_PORT=6379

# Database created inside the Mongo container.
MONGO_DB_NAME=enterprise_erp

# Cache ceiling before Redis starts evicting least-recently-used keys.
REDIS_MAXMEMORY=256mb
