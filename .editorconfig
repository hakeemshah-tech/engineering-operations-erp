# https://editorconfig.org
# Applies to every editor/IDE with EditorConfig support, so formatting stays
# consistent regardless of local settings.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[{package.json,package-lock.json,turbo.json}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{sh,bash}]
end_of_line = lf

[.husky/*]
end_of_line = lf
